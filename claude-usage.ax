# @name    Claude Usage
# @desc    Unofficial: your Claude plan limits (5-hour and weekly window) live on the clock, with the Claude mascot getting nervous as you approach the limit. Values arrive over MQTT from a small Claude Code status line script: github.com/f2daz/awtrix-claude-usage. Works with Pro/Max; tested with a Team plan. Not affiliated with Anthropic.
# @author  f2daz
# @version 1.1
# @display 52x16
# @icons   claude-mascot-ok-claude-usage, claude-mascot-warning-claude-usa, claude-mascot-alert-claude-usage, claude-mascot-knocked-out-claude
# @config  topic text   "MQTT topic"        default="claude-code/usage" maxlen=120 help="Retained JSON with five_hour_pct, seven_day_pct, five_hour_resets_at, seven_day_resets_at"
# @config  warn  number "Warning from"      default=70 min=10 max=100 unit=% help="Orange values and a worried mascot from here"
# @config  alert number "Alert from"        default=90 min=10 max=100 unit=% help="Red values and an alarmed mascot from here"
# @config  stale number "Old after"         default=30 min=5 max=240 unit=min help="A dark red frame marks the values when nothing arrived for this long"
# @config  reset bool   "Show reset time"   default=true help="Alternates every 4 s between the percentage and the time until the window resets"
# @config  hide  bool   "Hide without data" default=true help="Skip the app in the rotation until the first values arrived"
# @config  notify bool  "Notifications"     default=true help="A notification with the mascot when a window crosses the warning or alert level, or runs out"
# @config  sound bool   "Notification sound" default=false
# @config  snd1  text   "Warning melody"    default="" maxlen=24 help="Name of a stored melody; empty = built-in"
# @config  snd2  text   "Alert melody"      default="" maxlen=24 help="Name of a stored melody; empty = built-in"
# @config  snd3  text   "Used up melody"    default="" maxlen=24 help="Name of a stored melody; empty = built-in"
# @config  qfrom number "Quiet from"        default=22 min=0 max=23 help="Hour; no sound from here"
# @config  qto   number "Quiet until"       default=7  min=0 max=23
#
# Expected payload (retained), e.g. published by the Claude Code status line:
#   {"five_hour_pct":11.0,"five_hour_resets_at":1791453000,"seven_day_pct":41.0,"seven_day_resets_at":1791756000}
# Percentages 0..100 (or null when a window is not active), reset times in Unix seconds.
import json

class ClaudeUsage
  var five, seven, five_at, seven_at, rx
  var l5, l7, c5, c7, w5, w7, top, old

  def init()
    self.five = nil self.seven = nil self.five_at = nil self.seven_at = nil
    self.rx = nil
    self.l5 = "--" self.l7 = "--"
    self.c5 = 0x888888 self.c7 = 0x888888
    self.w5 = 0 self.w7 = 0
    self.top = 0.0
    self.old = false
  end

  def setup()
    var t = store.get("topic")
    if t == nil || t == "" t = "claude-code/usage" end
    mqtt.subscribe(t, / topic, payload -> self.on_msg(payload))
  end

  def on_msg(payload)
    var d = json.load(payload)
    if !isinstance(d, map) return end
    self.five = d.find("five_hour_pct")
    self.seven = d.find("seven_day_pct")
    self.five_at = d.find("five_hour_resets_at")
    self.seven_at = d.find("seven_day_resets_at")
    self.rx = now_ms()
    self.build()
    self.check("5H", self.five, "lv5")
    self.check("7D", self.seven, "lv7")
  end

  # Level per window: 0 normal, 1 warning, 2 alert, 3 used up. Rising crossings notify once;
  # the level drops again below warning - 5 (e.g. after a reset). Kept in the store, so a
  # restart or the first message after installing never notifies.
  def check(label, p, key)
    if p == nil return end
    var w = num(store.get("warn"), 70), a = num(store.get("alert"), 90)
    var prev = store.get(key), lvl = prev == nil ? 0 : prev
    var now_lvl = p >= 100 ? 3 : (p >= a ? 2 : (p >= w ? 1 : 0))
    if now_lvl > lvl lvl = now_lvl
    elif p < w - 5 lvl = 0
    end
    if prev != nil && lvl > prev && store.get("notify") != false self.tell(label, p, lvl) end
    if lvl != prev store.set(key, lvl) end
  end

  def quiet()
    var h = hour(), a = num(store.get("qfrom"), 22), b = num(store.get("qto"), 7)
    if h < 0 || a == b return false end
    return a < b ? (h >= a && h < b) : (h >= a || h < b)
  end

  def tell(label, p, lvl)
    var icons = ["", "claude-mascot-warning-claude-usa", "claude-mascot-alert-claude-usage", "claude-mascot-knocked-out-claude"]
    var colour = lvl == 1 ? 0xFFA020 : 0xFF3020
    var n = {"name": "claude-usage", "durationMs": 10000,
             "layout": {"version": 1, "regions": [
               {"id": "i", "box": [0, 0, 22, 16], "icon": icons[lvl]},
               {"id": "a", "box": [23, 0, 29, 8], "text": "CLAUDE", "color": 0xD97757},
               {"id": "b", "box": [23, 8, 29, 8], "text": label + format(" %d%%", int(p + 0.5)), "color": colour}]}}
    if store.get("sound") == true && !self.quiet()
      var own = store.get(["", "snd1", "snd2", "snd3"][lvl])
      var builtin = ["", "warn:d=8,o=5,b=160:e,g,p,e,g", "alert:d=16,o=6,b=200:a,p,a,p,a,8p,a,p,a,p,a", "out:d=8,o=5,b=100:g,f#,f,2e"]
      n["sound"] = (own != nil && own != "") ? own : {"rtttl": builtin[lvl]}
    end
    if !notify(n) log("notification refused") end
  end

  def colour(p)
    if p == nil return 0x888888 end
    if p >= num(store.get("alert"), 90) return 0xFF3020 end
    if p >= num(store.get("warn"), 70) return 0xFFA020 end
    return 0x30D050
  end

  # Time until a window resets: "2:15" below a day, "87H" above (a "D" reads like "0" in the small font)
  def left(at)
    var now = epoch_ms()
    if at == nil || now <= 0 return nil end
    var s = int(at) - now / 1000
    if s < 0 s = 0 end
    if s >= 86400 return format("%dH", (s + 1800) / 3600) end
    return format("%d:%02d", s / 3600, (s % 3600) / 60)
  end

  def build()
    var show_reset = store.get("reset") != false && (now_ms() / 4000) % 2 == 1
    var a = show_reset ? self.left(self.five_at) : nil
    var b = show_reset ? self.left(self.seven_at) : nil
    self.l5 = self.five == nil ? "--" : (a != nil ? a : format("%d%%", int(self.five + 0.5)))
    self.l7 = self.seven == nil ? "--" : (b != nil ? b : format("%d%%", int(self.seven + 0.5)))
    self.c5 = self.colour(self.five)
    self.c7 = self.colour(self.seven)
    self.w5 = self.five == nil ? 0 : clamp(int(self.five * 29 / 100 + 0.5), 0, 29)
    self.w7 = self.seven == nil ? 0 : clamp(int(self.seven * 29 / 100 + 0.5), 0, 29)
    var m = 0.0
    if self.five != nil && self.five > m m = self.five end
    if self.seven != nil && self.seven > m m = self.seven end
    self.top = m
    self.old = self.rx != nil && now_ms() - self.rx > num(store.get("stale"), 30) * 60000
  end

  def loop()
    if self.rx != nil self.build() end
  end

  def should_show()
    return !(store.get("hide") != false && self.rx == nil)
  end

  def mascot()
    var a = num(store.get("alert"), 90), w = num(store.get("warn"), 70)
    if self.top >= 100 return "claude-mascot-knocked-out-claude" end
    if self.top >= a return "claude-mascot-alert-claude-usage" end
    if self.top >= w return "claude-mascot-warning-claude-usa" end
    return "claude-mascot-ok-claude-usage"
  end

  def draw()
    clear()
    if !icon(self.mascot(), 0, 0)
      rect_fill(4, 3, 14, 9, 0xD97757)          # placeholder when the icon is missing
    end
    font("small")
    var x = 23 + text(23, 6, "5H ", 0xD97757)    # text() returns the width it used
    text(x, 6, self.l5, self.c5)
    x = 23 + text(23, 14, "7D ", 0xD97757)
    text(x, 14, self.l7, self.c7)
    rect_fill(23, 7, 29, 1, 0x202020)
    rect_fill(23, 15, 29, 1, 0x202020)
    if self.w5 > 0 rect_fill(23, 7, self.w5, 1, self.c5) end
    if self.w7 > 0 rect_fill(23, 15, self.w7, 1, self.c7) end
    if self.old rect(0, 0, 52, 16, 0x6E0700) end
  end
end

return ClaudeUsage()
